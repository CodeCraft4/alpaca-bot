# =============================================================================
# ALPHACA-ABNB: single env file for the whole project (BACKEND-ONLY secrets)
# The frontend needs NO keys: in dev Vite proxies /api -> http://localhost:4555.
# Load order: .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env
# NEVER prefix secrets with VITE_ (Vite would ship them to every browser).
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=4555
# Browser origin allowed by CORS (production: your real frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# --- Alpaca (paper by default; live needs BOTH lines below changed) -----------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex
ALPACA_TRADING_ENV=paper
ALLOW_LIVE=false

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dashboard > Connect > Session pooler. Needed to run migrations + for the API.
DATABASE_URL=

# --- Market analysis (AI) ----------------------------------------------------
# rules | anthropic | groq | xai   (falls back to rules if the model call fails)
ANALYSIS_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Trading rules (defaults; editable later from the Settings page) ----------
TRADING_SYMBOL=ABNB
DEFAULT_PROFIT_TARGET_PCT=3.0
DEFAULT_STOP_LOSS_PCT=5.0
HOLDING_REVIEW_DAYS=3

# --- Automation (dry run = logs only, never sells) ----------------------------
AUTOMATION_ENABLED=true
AUTOMATION_DRY_RUN=true
AUTOMATION_INTERVAL_SEC=60

# --- Alerts ------------------------------------------------------------------
ALERT_NOTIFICATION_EMAIL=

# --- Email (nodemailer / SMTP) ----------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=<your gmail>, SMTP_PASS=<16-char App Password (Google Account > Security > App passwords)>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ABNB Trading Bot <your-gmail@gmail.com>
# Used for the buttons inside emails
APP_URL=http://localhost:5173

# --- Finnhub: real-time price + news + earnings + analyst ratings (free key: https://finnhub.io/register) ---
FINNHUB_API_KEY=

# Alpaca paper executes $0.01 less than the dollar amount you type; this adds it back (paper only)
NOTIONAL_TOP_UP=0.01
